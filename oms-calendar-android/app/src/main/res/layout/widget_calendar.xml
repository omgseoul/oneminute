<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_panel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_background">
 <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_previous" android:layout_width="28dp" android:layout_height="match_parent" android:gravity="center" android:text="‹" android:textSize="25sp" android:textColor="#17243A" android:contentDescription="이전 달"/>
  <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textColor="#17243A" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/widget_task_heading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="OMS To do" android:textColor="#17243A" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
  <TextView android:id="@+id/widget_count" android:layout_width="wrap_content" android:layout_height="24dp" android:minWidth="25dp" android:paddingHorizontal="6dp" android:gravity="center" android:background="@drawable/widget_count" android:textColor="#2563EB" android:textSize="12sp" android:textStyle="bold" android:visibility="gone"/>
  <TextView android:id="@+id/widget_next" android:layout_width="28dp" android:layout_height="match_parent" android:gravity="center" android:text="›" android:textSize="25sp" android:textColor="#17243A" android:contentDescription="다음 달"/>
  <TextView android:id="@+id/widget_action" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="10dp" android:gravity="center" android:background="@drawable/widget_today" android:textSize="24sp" android:textColor="#FFFFFF" android:visibility="gone"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
 <LinearLayout android:id="@+id/widget_entries" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
 <ListView android:id="@+id/widget_task_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:divider="#E9EDF3" android:dividerHeight="1dp" android:scrollbars="vertical" android:fadeScrollbars="false" android:scrollbarStyle="insideOverlay" android:visibility="gone"/>
 <TextView android:id="@+id/widget_task_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:textSize="12sp" android:textColor="#758094" android:visibility="gone"/>
</LinearLayout>