<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_entry" android:layout_width="match_parent" android:layout_height="25dp" android:gravity="center_vertical">
 <TextView android:id="@+id/widget_marker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingEnd="7dp" android:textColor="#526be3" android:textSize="15sp"/>
 <TextView android:id="@+id/widget_entry_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#17254b" android:textSize="13sp"/>
 <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="5dp" android:paddingEnd="5dp" android:textColor="#3852a0" android:textSize="11sp"/>
 <TextView android:id="@+id/widget_when" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#495877" android:textSize="11sp"/>
</LinearLayout>